{
    "manifest_version" :3,
    "name":"Lead Tracker",
    "version":"1.0",
    "description":"A simple lead tracker for tracking your leads",
    "action":{
        "default_popup":"index.html",
        "default_icon":"icon16.png"
    },
    "icons":{
        "128":"icon128.png",
        "48":"icon48.png",
        "16":"icon16.png"
    },
    "permissions": [
        "tabs"
    ]
}